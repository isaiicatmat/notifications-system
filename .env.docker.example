# Used by docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@db:5432/notifications?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@db:5432/notifications_test?schema=public
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-min
JWT_EXPIRES_IN=1h
SWAGGER_ENABLED=true
WORKER_IN_PROCESS=false
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=2000
WORKER_LOCK_TIMEOUT_MS=60000