# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications?schema=public

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=user-your-own:example:iB923qYCOGe5zLGbB764kjZWuIo9/ClGJhU85an0lXC19JXxh28jlNNagb7OekVL
JWT_EXPIRES_IN=1h

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=2000
WORKER_LOCK_TIMEOUT_MS=60000
# Run the worker inside the API process (handy for local development)
WORKER_IN_PROCESS=false

# Swagger UI at /docs
SWAGGER_ENABLED=true